# 复制为 .env 后填写（cp .env.example .env），切勿把真实 .env 提交到 git

# ── exam-solver 登录（页面上传/管理接口的 Basic Auth）──
EXAM_AUTH_USER=exam
EXAM_AUTH_PASS=change-me-strong-password

# ── 火山方舟 Ark（视觉 OCR 与答题的默认兜底模型）──
# 端点为订阅制 plan 端点；也可不用它，改在网页「模型配置」卡里添加模型
HS_PLAN_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── kb-service 访问密钥（自定随机串，solver 与你 curl 时用 X-API-Key 头）──
KB_API_KEY=kbk_change-me-random

# ── 宿主机端口（可选，默认与线上一致）──
# SOLVER_PORT=8092
# OCR_PORT=8093
# KB_PORT=8090
